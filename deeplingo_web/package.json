{
  "name": "deeplingo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "test:e2e:deterministic": "playwright test",
    "test:e2e:responsive": "playwright test -c playwright.responsive.config.ts",
    "report:responsive": "node scripts/responsive_report.mjs",
    "audit:build": "node scripts/audit-build.mjs",
    "audit:release": "node scripts/audit-build.mjs --strict-release",
    "build:release": "node scripts/build-release.mjs",
    "release:gates": "node scripts/run-release-gates.mjs",
    "manifest:release": "node scripts/generate-release-manifest.mjs",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "check:bundle": "node scripts/measure-bundle.mjs --budget 116",
    "lint": "eslint src e2e --max-warnings=9999"
  },
  "dependencies": {
    "@fontsource/wix-madefor-text": "^5.3.0",
    "@supabase/auth-js": "2.117.3",
    "@tanstack/react-query": "^5.59.0",
    "hanzi-writer": "^3.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.0",
    "playwright": "1.63.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.1.1"
  }
}
