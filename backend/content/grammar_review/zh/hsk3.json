   "lesson": {
    "summary": "Câu chữ 把 đưa tân ngữ lên trước động từ để nói việc xử lý tân ngữ đó và kết quả.",
    "rules": [
     "Cấu trúc: S + 把 + O + động từ + thành phần khác: 请把门关上。",
     "Động từ không đứng một mình, cần có bổ ngữ, 了, hoặc cụm khác: 我把作业做完了。",
     "Phủ định đặt 没(有) hoặc 别 trước 把: 她没把门关好。",
     "Tân ngữ sau 把 thường là xác định."
    ],
    "examples": [
     {
      "text": "请把门关上。",
      "meaning": "Làm ơn đóng cửa lại."
     },
     {
      "text": "我把作业做完了。",
      "meaning": "Tôi đã làm xong bài tập."
     },
     {
      "text": "他把杯子放在桌子上。",
      "meaning": "Anh ấy đặt cốc lên bàn."
     }
    ],
    "mistakes": [
     {
      "wrong": "请门关上。",
      "right": "请把门关上。",
      "why": "Muốn nhấn việc xử lý tân ngữ cần 把."
     },
     {
      "wrong": "我把作业做。",
      "right": "我把作业做完了。",
      "why": "Sau động từ trong câu 把 phải có thêm thành phần."
     }
    ]
   }
