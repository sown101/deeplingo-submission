   "lesson": {
    "summary": "让, 使, 叫 + người + động từ/tính từ nói ai khiến cho ai làm hoặc cảm thấy gì.",
    "rules": [
     "让 + O + V: mẹ bảo/cho phép làm: 妈妈让我早点回家。",
     "使 + O + tính từ/động từ: khiến cho (trang trọng): 这件事使大家很感动。",
     "叫 + O + V: bảo, gọi (khẩu ngữ): 老师叫我们明天早点来。",
     "让 cũng dùng cho cảm xúc: 这个消息让我很高兴。"
    ],
    "examples": [
     {
      "text": "妈妈让我早点回家。",
      "meaning": "Mẹ bảo tôi về nhà sớm."
     },
     {
      "text": "这件事使大家很感动。",
      "meaning": "Chuyện này khiến mọi người rất xúc động."
     },
     {
      "text": "你让我等了一个小时。",
      "meaning": "Bạn để tôi đợi một tiếng đồng hồ."
     }
    ],
    "mistakes": [
     {
      "wrong": "妈妈把我早点回家。",
      "right": "妈妈让我早点回家。",
      "why": "Sai khiến dùng 让, không dùng 把."
     },
     {
      "wrong": "这个消息被我很高兴。",
      "right": "这个消息让我很高兴。",
      "why": "Gây cảm xúc dùng 让/使."
