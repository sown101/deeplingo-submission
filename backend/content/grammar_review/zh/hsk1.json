      "questions": [
        {
          "id": "zh.hsk1.shi.01",
          "prompt": "Điền từ để nói “Tôi là học sinh”: 我___学生。",
          "options": [
            {
              "id": "a",
              "text": "是"
            },
            {
              "id": "b",
              "text": "吗"
            },
            {
              "id": "c",
              "text": "的"
            },
            {
              "id": "d",
              "text": "不"
            }
          ],
          "correct_option_id": "a",
          "explanation": "Dùng 是 để nối chủ ngữ với danh từ chỉ danh tính: 我是学生 (Tôi là học sinh)."
        },
        {
          "id": "zh.hsk1.shi.02",
          "prompt": "Chọn câu hoàn chỉnh có nghĩa “Cô ấy là bác sĩ”.",
          "options": [
            {
              "id": "a",
              "text": "她医生是。"
            },
            {
              "id": "b",
              "text": "是她医生。"
            },
            {
              "id": "c",
              "text": "她的医生。"
            },
            {
              "id": "d",
              "text": "她是医生。"
            }
          ],
          "correct_option_id": "d",
          "explanation": "Trật tự là chủ ngữ + 是 + danh từ: 她是医生. 她的医生 chỉ là cụm “bác sĩ của cô ấy”, không phải câu được yêu cầu."
        },
        {
          "id": "zh.hsk1.shi.03",
          "prompt": "Điền từ để nói “Họ là người Trung Quốc”: 他们___中国人。",
          "options": [
            {
              "id": "a",
              "text": "在"
            },
            {
              "id": "b",
              "text": "吗"
            },
            {
              "id": "c",
              "text": "是"
            },
            {
              "id": "d",
              "text": "的"
            }
          ],
          "correct_option_id": "c",
          "explanation": "是 dùng để nối 他们 với danh từ 中国人: 他们是中国人. 是 giữ nguyên dù chủ ngữ là một hay nhiều người."
        },
        {
          "id": "zh.hsk1.shi.04",
          "prompt": "Hoàn thành lời đáp “Không, tôi là học sinh”: A: 你是老师吗？ B: 不，我___学生。",
          "options": [
            {
              "id": "a",
              "text": "吗"
            },
            {
              "id": "b",
              "text": "是"
            },
            {
              "id": "c",
              "text": "的"
            },
            {
              "id": "d",
              "text": "很"
            }
          ],
          "correct_option_id": "b",
          "explanation": "Người nói trả lời không phải giáo viên rồi giới thiệu mình là học sinh: 不，我是学生. Dùng 是 trước danh từ 学生."
        }
      ],
      "lesson": {
        "summary": "是 nối chủ ngữ với danh từ để nói ai là ai, cái gì là cái gì.",
        "rules": [
          "Cấu trúc: chủ ngữ + 是 + danh từ (我是学生).",
          "Phủ định: 不是 (他不是老师).",
          "Không dùng 是 trước tính từ: nói 我很忙, không nói 我是忙."
        ],
        "examples": [
          {
            "text": "我是越南人。",
            "meaning": "Tôi là người Việt Nam."
          },
          {
            "text": "她不是医生。",
            "meaning": "Cô ấy không phải bác sĩ."
          },
          {
            "text": "这是我的书。",
            "meaning": "Đây là sách của tôi."
          }
        ],
        "mistakes": [
          {
            "wrong": "我是很高兴。",
            "right": "我很高兴。",
            "why": "Trước tính từ dùng 很, không dùng 是."
          }
        ]
      }
    },
