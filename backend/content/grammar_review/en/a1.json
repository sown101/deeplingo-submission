        {
          "id": "en.a1.possessive_adjectives.04",
          "prompt": "Chọn từ đúng: They have two bikes. These are ___ bikes.",
          "options": [
            {
              "id": "a",
              "text": "theirs"
            },
            {
              "id": "b",
              "text": "them"
            },
            {
              "id": "c",
              "text": "they"
            },
            {
              "id": "d",
              "text": "their"
            }
          ],
          "correct_option_id": "d",
          "explanation": "Their đứng trước danh từ để nói “của họ”: their bikes. Theirs là đại từ sở hữu và không đứng ngay trước bikes."
        }
      ],
      "lesson": {
        "summary": "Từ chỉ sở hữu đứng trước danh từ để nói vật thuộc về ai: my, your, his, her, its, our, their.",
        "rules": [
          "Chọn theo người sở hữu, không theo vật: his mother (mẹ của anh ấy).",
          "Không dùng thêm mạo từ: my car, không nói the my car.",
          "Its (của nó) khác it's (= it is)."
        ],
        "examples": [
          {
            "text": "This is my brother.",
            "meaning": "Đây là anh trai tôi."
          },
          {
            "text": "Their house is big.",
            "meaning": "Nhà của họ to."
          },
          {
            "text": "The dog wags its tail.",
            "meaning": "Con chó vẫy đuôi."
          }
        ],
        "mistakes": [
          {
            "wrong": "She loves his mother.",
            "right": "She loves her mother.",
            "why": "Người sở hữu là she nên dùng her."
          },
          {
            "wrong": "It's color is red.",
            "right": "Its color is red.",
            "why": "Its là sở hữu; it's là it is."
          }
        ]
      }
    },
