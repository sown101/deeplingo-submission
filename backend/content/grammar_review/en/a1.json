    {
      "key": "en.a1.be",
      "title": "To be ở hiện tại: khẳng định, phủ định và câu hỏi",
      "topic_key": "verbs",
      "questions": [
        {
          "id": "en.a1.be.01",
          "prompt": "Chọn dạng đúng của be: I ___ a student.",
          "options": [
            {
              "id": "a",
              "text": "am"
            },
            {
              "id": "b",
              "text": "is"
            },
            {
              "id": "c",
              "text": "are"
            },
            {
              "id": "d",
              "text": "be"
            }
          ],
          "correct_option_id": "a",
          "explanation": "Với chủ ngữ I, dạng hiện tại của be là am: I am a student (Tôi là học sinh)."
        },
        {
          "id": "en.a1.be.02",
          "prompt": "Chọn dạng đúng của be: They ___ at home.",
          "options": [
            {
              "id": "a",
              "text": "is"
            },
            {
              "id": "b",
              "text": "am"
            },
            {
              "id": "c",
              "text": "be"
            },
            {
              "id": "d",
              "text": "are"
            }
          ],
          "correct_option_id": "d",
          "explanation": "They đi với are: They are at home (Họ đang ở nhà)."
        },
        {
          "id": "en.a1.be.03",
          "prompt": "Chọn từ mở đầu câu hỏi: ___ she your teacher?",
          "options": [
            {
              "id": "a",
              "text": "Am"
            },
            {
              "id": "b",
              "text": "Are"
            },
            {
              "id": "c",
              "text": "Is"
            },
            {
              "id": "d",
              "text": "Be"
            }
          ],
          "correct_option_id": "c",
          "explanation": "She đi với is. Khi hỏi có/không, đưa is lên trước chủ ngữ: Is she your teacher?"
        },
        {
          "id": "en.a1.be.04",
          "prompt": "Điền dạng phủ định của be: He ___ tired. He feels fine.",
          "options": [
            {
              "id": "a",
              "text": "aren't"
            },
            {
              "id": "b",
              "text": "isn't"
            },
            {
              "id": "c",
              "text": "am not"
            },
            {
              "id": "d",
              "text": "don't"
            }
          ],
          "correct_option_id": "b",
          "explanation": "He đi với is; dạng phủ định is not thường rút gọn thành isn't. He isn't tired nghĩa là anh ấy không mệt."
        }
      ],
      "lesson": {
        "summary": "Be ở hiện tại có ba dạng: am, is, are. Dùng để nói ai là ai, ở đâu, như thế nào.",
        "rules": [
          "I đi với am; he, she, it và danh từ số ít đi với is; you, we, they và danh từ số nhiều đi với are.",
          "Phủ định: thêm not sau be (I am not, she isn't, they aren't).",
          "Câu hỏi: đưa be lên trước chủ ngữ (Are you a student? Is he at home?)."
        ],
        "examples": [
          {
            "text": "I am a teacher.",
            "meaning": "Tôi là giáo viên."
          },
          {
            "text": "She isn't at work today.",
            "meaning": "Hôm nay cô ấy không ở chỗ làm."
          },
          {
            "text": "Are they your friends?",
            "meaning": "Họ là bạn của bạn à?"
          }
        ],
        "mistakes": [
          {
            "wrong": "She are happy.",
            "right": "She is happy.",
            "why": "She là ngôi thứ ba số ít nên dùng is."
          },
          {
            "wrong": "I not am tired.",
            "right": "I am not tired.",
            "why": "Not đứng sau be."
          }
        ]
      }
    },
    {
