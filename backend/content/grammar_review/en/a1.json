        },
        {
          "id": "en.a1.articles.04",
          "prompt": "Chọn mạo từ bất định để giới thiệu một quyển sách chưa nhắc tới: I have ___ book.",
          "options": [
            {
              "id": "a",
              "text": "an"
            },
            {
              "id": "b",
              "text": "the"
            },
            {
              "id": "c",
              "text": "a"
            },
            {
              "id": "d",
              "text": "(không có mạo từ)"
            }
          ],
          "correct_option_id": "c",
          "explanation": "Book là danh từ đếm được số ít và bắt đầu bằng âm phụ âm. Dùng a book khi giới thiệu một quyển sách chưa xác định."
        }
      ],
      "lesson": {
        "summary": "A và an dùng cho một vật bất kỳ, lần đầu nhắc tới; the dùng cho vật cả hai người đều biết.",
        "rules": [
          "A trước âm phụ âm (a book, a university); an trước âm nguyên âm (an apple, an hour).",
          "The khi vật đã được nhắc hoặc chỉ có một (the sun, the book I bought).",
          "Danh từ số nhiều nói chung không cần mạo từ (Dogs are friendly)."
        ],
        "examples": [
          {
            "text": "I have a cat. The cat is black.",
            "meaning": "Tôi có một con mèo. Con mèo đó màu đen."
          },
          {
            "text": "She eats an orange every day.",
            "meaning": "Ngày nào cô ấy cũng ăn một quả cam."
          }
        ],
        "mistakes": [
          {
            "wrong": "I am an student.",
            "right": "I am a student.",
            "why": "Student bắt đầu bằng âm phụ âm /s/."
          }
        ]
      }
