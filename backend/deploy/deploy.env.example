# Copy to a runtime directory outside the repo (e.g. ~/deeplingo-runtime/deploy.env)
# and pass it with --env-file. This file holds no secrets.

# Image tag built from backend/Dockerfile; use a new tag per release, keep the old one for rollback.
BACKEND_IMAGE=deeplingo-backend:rev1

# Absolute path to the backend settings file (Supabase, AI provider, CORS...).
# Keep it chmod 600 and outside the repo. Variable names: app/platform/config.py.
DEEPLINGO_ENV_FILE=/home/USER/deeplingo-runtime/backend.env

# Public API hostname whose DNS A record points at this host, e.g. api-staging.example.com
# or 34-1-2-3.sslip.io. Caddy obtains the HTTPS certificate for it.
API_HOSTNAME=api-staging.example.com

# L2: after approving/applying its migration, start with --profile speaking-analysis.
# In the backend settings file (DEEPLINGO_ENV_FILE), explicitly set:
# COMPANION_SESSION_TEXT_REDIS_URL=redis://speaking-text:6379/0
# COMPANION_SESSION_EVENTS_MODEL=<configured structured-text model>
# The application refuses raw-text writes if Redis has AOF, snapshots or replicas enabled.
